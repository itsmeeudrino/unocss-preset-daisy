{
  "name": "unocss-preset-daisy",
  "version": "0.1.0",
  "description": "daisyUI v5 ported to UnoCSS — zero-Tailwind preset (hard fork of daisyui@5.7.43)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./themes": "./dist/themes.css"
  },
  "files": ["dist"],
  "scripts": {
    "build": "bun build.ts",
    "test": "bun test",
    "check": "bun run build && bun test",
    "inventory": "bun scripts/inventory-apply.ts",
    "tokens": "bun scripts/generate-tokens.ts",
    "playground": "bun playground/serve.ts"
  },
  "dependencies": {
    "unocss": "latest"
  },
  "peerDependencies": {
    "unocss": ">=0.60.0"
  }
}
