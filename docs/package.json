{
  "name": "daisyui-docs-uno",
  "version": "0.1.0",
  "description": "daisyUI docs (Option A 1:1 fork of saadeghi/daisyui packages/docs), Tailwind swapped for unocss-preset-daisy",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "test": "bun test src",
    "verify": "bun run --parallel test lang:validate sync:themes",
    "lang:validate": "bun scripts/validateTranslations.js",
    "sync:themes": "bun scripts/syncThemes.js"
  },
  "dependencies": {
    "unocss-preset-daisy": "file:..",
    "theme-change": "3.0.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@unocss/preset-typography": "66.10.5",
    "@unocss/vite": "66.10.5",
    "js-yaml": "5.2.2",
    "mdsvex": "0.12.8",
    "svelte": "5.56.8",
    "unocss": "66.10.5",
    "vite": "8.1.5"
  }
}
