# Optional live API for stars/discounts/testimonials (upstream: api.daisyui.com).
# Everything renders without it — unset/empty degrades gracefully:
# - stats (stargazers) -> null (Navbar hides the star badge)
# - discount (shorttime/special) -> null (Navbar countdown tooltip stays hidden)
# - testimonials/roadmap -> [] (sections render nothing / empty timeline)
# - Carbon ads -> slot collapses; confetti -> no-op
# See src/lib/external.js + (routes)/+layout.server.js.
PUBLIC_DAISYUI_API_PATH=https://api.daisyui.com
